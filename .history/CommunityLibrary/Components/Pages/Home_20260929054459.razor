@page "/"
@inject NavigationManager Navigation

<PageTitle>Home - Community Library</PageTitle>

<div class="main-container d-flex flex-column align-items-center py-4">

    <!-- Home Page Title Banner -->
    <div class="home-page-banner text-center mb-5">
        Home Page
    </div>

    <!-- Books Grid (Horizontal Row of 3 Books) -->
    <div class="container mb-5">
        <div class="row justify-content-center g-4">
            
            <!-- Book 1 -->
            <div class="col-md-4 d-flex flex-column align-items-center">
                <div class="book-square d-flex align-items-center justify-content-center mb-3">
                    Book
                </div>
                <div class="metadata-box d-flex align-items-center justify-content-center text-center p-3">
                    Description and metadata of the book
                </div>
            </div>

            <!-- Book 2 -->
            <div class="col-md-4 d-flex flex-column align-items-center">
                <div class="book-square d-flex align-items-center justify-content-center mb-3">
                    Book
                </div>
                <div class="metadata-box d-flex align-items-center justify-content-center text-center p-3">
                    Description and metadata of the book
                </div>
            </div>

            <!-- Book 3 -->
            <div class="col-md-4 d-flex flex-column align-items-center">
                <div class="book-square d-flex align-items-center justify-content-center mb-3">
                    Book
                </div>
                <div class="metadata-box d-flex align-items-center justify-content-center text-center p-3">
                    Description and metadata of the book
                </div>
            </div>

        </div>
    </div>

    

    <!-- Edit Button near bottom -->
    <div class="text-center mb-4">
        <button class="btn btn-warning fw-bold px-4 py-2" @onclick="ToggleEditMode">
            ✏️ EDIT
        </button>
    </div>

</div>

@code {
    private bool isEditMode = false;

    private void ToggleEditMode()
    {
        isEditMode = !isEditMode;
    }
}