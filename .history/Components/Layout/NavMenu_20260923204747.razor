@using Microsoft.AspNetCore.Components.Routing

<div class="navbar navbar-expand-md navbar-dark bg-dark px-4 shadow-sm">
    <div class="container-fluid d-flex align-items-center justify-content-between">
        
        <!-- App Title / Brand Logo -->
        <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2" href="">
            <span class="bi bi-journal-bookmark-fill text-primary" aria-hidden="true"></span>
            Community Library
        </a>

        <!-- Mobile Menu Toggle Button -->
        <input type="checkbox" id="navbar-toggler-state" class="d-none" />
        <label for="navbar-toggler-state" class="navbar-toggler border-0 cursor-pointer" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </label>

        <!-- Horizontal Navigation Links -->
        <div class="nav-menu-container">
            <nav class="d-flex align-items-center gap-2">
                <NavLink class="nav-link px-3 py-2 rounded text-white" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill me-1" aria-hidden="true"></span> Home
                </NavLink>

                <NavLink class="nav-link px-3 py-2 rounded text-white" href="catalog">
                    <span class="bi bi-book-half me-1" aria-hidden="true"></span> Book Catalog
                </NavLink>

                <NavLink class="nav-link px-3 py-2 rounded text-white" href="dashboard">
                    <span class="bi bi-person-workspace me-1" aria-hidden="true"></span> My Dashboard
                </NavLink>

                <NavLink class="nav-link px-3 py-2 rounded text-white" href="admin/manage-books">
                    <span class="bi bi-gear-fill me-1" aria-hidden="true"></span> Admin Panel
                </NavLink>
            </nav>
        </div>

    </div>
</div>