@using Microsoft.AspNetCore.Components.Routing

<div class="top-nav-bar d-flex align-items-center justify-content-between px-3 shadow-sm">
    
    <!-- Top Left: LOGO Block -->
    <a class="navbar-brand logo-box d-flex align-items-center justify-content-center text-decoration-none fw-bold text-dark" href="">
        LOGO
    </a>

    <!-- Mobile Menu Toggle Button -->
    <input type="checkbox" id="navbar-toggler-state" class="d-none" />
    <label for="navbar-toggler-state" class="navbar-toggler border-0 cursor-pointer ms-auto me-2 d-md-none" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </label>

    <!-- Center: Horizontal Navigation Links -->
    <div class="nav-menu-container">
        <nav class="d-flex align-items-center gap-2 flex-wrap">
            <NavLink class="nav-btn text-dark text-decoration-none" href="" Match="NavLinkMatch.All">
                Home
            </NavLink>

            <NavLink class="nav-btn text-dark text-decoration-none" href="catalog">
                Catalog
            </NavLink>

            <NavLink class="nav-btn text-dark text-decoration-none" href="authors">
                Authors
            </NavLink>

            <NavLink class="nav-btn text-dark text-decoration-none" href="feature-1">
                feature en...
            </NavLink>

            <NavLink class="nav-btn text-dark text-decoration-none" href="feature-2">
                feature enhan...
            </NavLink>
        </nav>
    </div>

    <!-- Top Right: Account Circle -->
    <div class="d-flex align-items-center ms-2">
        <NavLink class="account-circle d-flex align-items-center justify-content-center text-decoration-none text-dark fw-semibold" href="Account/Login">
            Account
        </NavLink>
    </div>

</div>

<style>
    /* Top Bar Styling */
    .top-nav-bar {
        background-color: #ff9933;
        min-height: 70px;
        width: 100%;
        border-bottom: 1px solid #222;
    }

    /* LOGO Block (Top Left) */
    .logo-box {
        background-color: #ff9933;
        border: 1px solid #222;
        padding: 10px 20px;
        font-size: 1.1rem;
        min-width: 90px;
    }

    /* Nav Item Buttons (Teal) */
    .nav-btn {
        background-color: #4dd0e1;
        border: 1px solid #222;
        padding: 8px 18px;
        font-weight: 500;
        display: inline-block;
        transition: background-color 0.2s ease-in-out;
    }

    .nav-btn:hover, .nav-btn.active {
        background-color: #26c6da;
    }

    /* Account Circle (Top Right Green) */
    .account-circle {
        background-color: #66bb6a;
        border: 1px solid #222;
        width: 75px;
        height: 75px;
        border-radius: 50%;
        font-size: 0.95rem;
        transition: background-color 0.2s ease-in-out;
    }

    .account-circle:hover {
        background-color: #4caf50;
    }

    /* Responsive adjustment for small screens */
    @@media (max-width: 768px) {
        .nav-menu-container nav {
            flex-direction: column;
            width: 100%;
            margin-top: 10px;
        }

        .nav-btn {
            width: 100%;
            text-align: center;
        }
    }
</style>