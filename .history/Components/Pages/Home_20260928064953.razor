
@page "/"
@inject NavigationManager Navigation

<PageTitle>Home - Community Library</PageTitle>

<div class="container py-4">

    <!-- 1. Home Page Main Content (Justified Text) -->
    <section id="home-intro" class="p-4 p-md-5 mb-5 bg-light rounded-3 shadow-sm border">
        <h1 class="display-5 fw-bold text-primary mb-3">Welcome to the Community Library</h1>
        <p class="fs-5 text-secondary text-justify lead" style="text-align: justify; text-justify: inter-word;">
            Our Community Library system provides access to an expanding collection of physical and digital literature. 
            Designed to foster learning, research, and collaborative knowledge sharing, our platform allows members to explore 
            catalogs, track active book borrowings, and stay connected with community events. Browse through our catalog 
            or sign in to manage your account and reserve titles online.
        </p>
        <div class="mt-4">
            <a href="catalog" class="btn btn-primary btn-lg me-2">Explore Catalogue</a>
            <a href="Account/Register" class="btn btn-outline-secondary btn-lg">Join Library</a>
        </div>
    </section>

    <hr class="my-5" />

    <!-- 2. Book Section -->
    <section id="books-section" class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold">Featured Books</h2>
                <p class="text-muted mb-0">Discover popular and recently added titles in our library.</p>
            </div>
            <a href="catalog" class="btn btn-outline-primary btn-sm">View All Books</a>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <span class="badge bg-primary mb-2">Fiction</span>
                        <h5 class="card-title fw-bold">The Great Gatsby</h5>
                        <h6 class="card-subtitle mb-2 text-muted">F. Scott Fitzgerald</h6>
                        <p class="card-text text-muted" style="text-align: justify;">
                            A story of ambition, love, and the American Dream set during the Roaring Twenties.
                        </p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3">
                        <button class="btn btn-sm btn-outline-primary w-100">Borrow Book</button>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <span class="badge bg-success mb-2">Non-Fiction</span>
                        <h5 class="card-title fw-bold">Clean Code</h5>
                        <h6 class="card-subtitle mb-2 text-muted">Robert C. Martin</h6>
                        <p class="card-text text-muted" style="text-align: justify;">
                            A handbook of agile software craftsmanship with best practices for readable code.
                        </p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3">
                        <button class="btn btn-sm btn-outline-primary w-100">Borrow Book</button>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <span class="badge bg-info text-white mb-2">Technology</span>
                        <h5 class="card-title fw-bold">Learning Blazor</h5>
                        <h6 class="card-subtitle mb-2 text-muted">Web Development Series</h6>
                        <p class="card-text text-muted" style="text-align: justify;">
                            An essential guide to building interactive web applications using C# and Blazor.
                        </p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3">
                        <button class="btn btn-sm btn-outline-primary w-100">Borrow Book</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <hr class="my-5" />

    <!-- 3. FAQ Section -->
    <section id="faq-section" class="mb-5">
        <h2 class="fw-bold mb-4">Frequently Asked Questions (FAQ)</h2>
        <div class="accordion shadow-sm" id="libraryFaqAccordion">
            
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingOne">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne">
                        How do I borrow a book?
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#libraryFaqAccordion">
                    <div class="accordion-body text-muted" style="text-align: justify;">
                        To borrow a book, sign into your account, browse to the <strong>Catalogue</strong> page, select the desired title, and click the <strong>Borrow</strong> button. You can manage active loans in your user dashboard.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header" id="headingTwo">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                        How long can I keep a borrowed book?
                    </button>
                </h2>
                <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#libraryFaqAccordion">
                    <div class="accordion-body text-muted" style="text-align: justify;">
                        The standard loan duration is 14 days. You can request a loan extension through your dashboard prior to the due date if no other member has reserved the book.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header" id="headingThree">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree">
                        Who can register for a library account?
                    </button>
                </h2>
                <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#libraryFaqAccordion">
                    <div class="accordion-body text-muted" style="text-align: justify;">
                        Registration is open to all community members and students. Click the <strong>Account</strong> button at the top right to get started.
                    </div>
                </div>
            </div>

        </div>
    </section>

    <hr class="my-5" />

    <!-- 4. Edit Section -->
    <section id="edit-section" class="mb-5 p-4 bg-white border rounded-3 shadow-sm">
        <h2 class="fw-bold mb-3">Edit Page & Quick Actions</h2>
        <p class="text-muted" style="text-align: justify;">
            Administrative users can update featured book announcements, modify home page information, or edit catalog records directly below.
        </p>

        <div class="card p-3 border-secondary">
            <h5 class="fw-bold mb-3">Quick Edit Announcement</h5>
            <EditForm Model="announcementModel" OnValidSubmit="HandleAnnouncementSave">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Homepage Announcement Text</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="announcementModel.Text" placeholder="Enter updated welcome message or announcement..." />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save"></i> Save Changes
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">
                        Reset
                    </button>
                </div>
            </EditForm>
        </div>
    </section>

</div>

@code {
    private AnnouncementModel announcementModel = new();

    private void HandleAnnouncementSave()
    {
        // Add save logic here
    }

    private void ResetForm()
    {
        announcementModel = new();
    }

    public class AnnouncementModel
    {
        public string Text { get; set; } = string.Empty;
    }
}