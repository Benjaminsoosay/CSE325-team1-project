@page "/"
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation

<PageTitle>Home - Community Library</PageTitle>

<div class="main-layout-container d-flex flex-column align-items-center py-4 px-3">

    <div class="home-page-box d-flex align-items-center justify-content-center mb-5 text-white fw-bold">
        Home Page
    </div>

    <div class="container mb-5">
        <div class="row justify-content-center g-4">
            
            <!-- Book Unit 1 -->
            <div class="col-md-4 d-flex flex-column align-items-center">
               
                <div class="book-square-box d-flex align-items-center justify-content-center mb-3 fw-bold text-dark">
                    Book
                </div>
               
                <div class="metadata-box d-flex align-items-center justify-content-center text-center p-3 text-white">
                    Description and metadata of the book
                </div>
            </div>

            <div class="col-md-4 d-flex flex-column align-items-center">
               
                <div class="book-square-box d-flex align-items-center justify-content-center mb-3 fw-bold text-dark">
                    Book
                </div>
                <div class="metadata-box d-flex align-items-center justify-content-center text-center p-3 text-white">
                    Description and metadata of the book
                </div>
            </div>

            <div class="col-md-4 d-flex flex-column align-items-center">
               
                <div class="book-square-box d-flex align-items-center justify-content-center mb-3 fw-bold text-dark">
                    Book
                </div>
                <!-- Bottom Metadata Box (Grey Enclosure) -->
                <div class="metadata-box d-flex align-items-center justify-content-center text-center p-3 text-white">
                    Description and metadata of the book
                </div>
            </div>

        </div>
    </div>

    <!-- 3. FAQ Section Banner Box (Orange Enclosure) -->
    <div class="faq-box d-flex align-items-center justify-content-center mb-4 text-dark fw-bold">
        FAQ
    </div>

    <!-- 4. Edit Action Box (Enclosed Button Container) -->
    <div class="edit-box-container text-center mb-4">
        <button class="edit-btn text-dark fw-bold" @onclick="ToggleEditMode">
            EDIT
        </button>
    </div>

</div>

<style>
    /* Overall Layout Alignment */
    .main-layout-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    /* 1. Home Page Banner Box (Purple) */
    .home-page-box {
        background-color: #8c52ff;
        border: 1px solid #222;
        width: 100%;
        max-width: 450px;
        height: 50px;
        font-size: 1.25rem;
    }

    /* 2. Top Book Square Box (Teal) */
    .book-square-box {
        background-color: #4dd0e1;
        border: 1px solid #222;
        width: 100%;
        height: 240px;
        font-size: 1.2rem;
    }

    /* Bottom Book Metadata Box (Dark Grey) */
    .metadata-box {
        background-color: #666666;
        border: 1px solid #222;
        width: 100%;
        height: 120px;
        font-size: 0.95rem;
        line-height: 1.3;
    }

    /* 3. FAQ Banner Box (Orange) */
    .faq-box {
        background-color: #ff9933;
        border: 1px solid #222;
        width: 100%;
        height: 60px;
        font-size: 1.2rem;
    }

    /* 4. Edit Button Enclosure */
    .edit-btn {
        background-color: #ffca28;
        border: 1px solid #222;
        padding: 10px 40px;
        font-size: 1.1rem;
        cursor: pointer;
        transition: background-color 0.2s ease-in-out;
    }

    .edit-btn:hover {
        background-color: #ffb300;
    }
</style>

@code {
    private bool isEditMode = false;

    private void ToggleEditMode()
    {
        isEditMode = !isEditMode;
    }
}