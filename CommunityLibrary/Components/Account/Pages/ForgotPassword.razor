@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using CommunityLibrary.Data

@inject UserManager<ApplicationUser> UserManager
@inject IPasswordHasher<ApplicationUser> PasswordHasher
@inject SignInManager<ApplicationUser> SignInManager

<PageTitle>Forgot your password?</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="text-center">Forgot your password?</h1>
        <hr />

        @if (!_verified)
        {
            <h2 class="text-center">Enter your email and security word.</h2>
            <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="VerifySecurityWord" method="post">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />

                @if (_errorMessage is not null)
                {
                    <div class="alert alert-danger">@_errorMessage</div>
                }

                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label for="Input.Email">Email</label>
                    <ValidationMessage For="() => Input.Email" class="text-danger" />
                </div>

                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.SecurityWord" id="Input.SecurityWord" class="form-control" autocomplete="off" aria-required="true" placeholder="security word" />
                    <label for="Input.SecurityWord">Security Word</label>
                    <ValidationMessage For="() => Input.SecurityWord" class="text-danger" />
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary px-4 py-2" style="min-width: 220px;">Verify</button>
                </div>
            </EditForm>
        }
        else
        {
            <h2 class="text-center">Enter your new password.</h2>
            <EditForm Model="ResetInput" FormName="reset-password" OnValidSubmit="ResetPasswordAsync" method="post">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />

                @if (_successMessage is not null)
                {
                    <div class="alert alert-success">@_successMessage</div>
                }

                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="ResetInput.NewPassword" id="ResetInput.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="new password" />
                    <label for="ResetInput.NewPassword">New Password</label>
                    <ValidationMessage For="() => ResetInput.NewPassword" class="text-danger" />
                </div>

                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="ResetInput.ConfirmPassword" id="ResetInput.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="confirm password" />
                    <label for="ResetInput.ConfirmPassword">Confirm Password</label>
                    <ValidationMessage For="() => ResetInput.ConfirmPassword" class="text-danger" />
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-success px-4 py-2" style="min-width: 220px;">Reset Password</button>
                </div>
            </EditForm>
        }

        <hr class="my-4" />
        <div class="text-center">
            <a href="Account/Login">Back to log in</a>
        </div>
    </div>
</div>

@code {
    private bool _verified = false;
    private string? _errorMessage;
    private string? _successMessage;
    private ApplicationUser? _user;

    [SupplyParameterFromForm(FormName = "forgot-password")]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "reset-password")]
    private ResetModel ResetInput { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
        ResetInput ??= new();
    }

    private async Task VerifySecurityWord()
    {
        _errorMessage = null;

        var user = await UserManager.FindByEmailAsync(Input.Email);

        if (user is null || user.SecurityWord is null)
        {
            _errorMessage = "Email or security word is incorrect.";
            return;
        }

        var result = PasswordHasher.VerifyHashedPassword(user, user.SecurityWord, Input.SecurityWord.ToLower());

        if (result == PasswordVerificationResult.Failed)
        {
            _errorMessage = "Email or security word is incorrect.";
            return;
        }

        _user = user;
        _verified = true;
    }

    private async Task ResetPasswordAsync()
    {
        if (_user is null) return;

        var token = await UserManager.GeneratePasswordResetTokenAsync(_user);
        var result = await UserManager.ResetPasswordAsync(_user, token, ResetInput.NewPassword);

        if (result.Succeeded)
        {
            _successMessage = "Password reset successfully. You can now log in.";
            _verified = false;
            Input = new();
            ResetInput = new();
        }
        else
        {
            _errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
            _verified = false;
        }
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        [RegularExpression(@"^[a-zA-Z]+$", ErrorMessage = "Security word must contain letters only.")]
        [Display(Name = "Security Word")]
        public string SecurityWord { get; set; } = "";
    }

    private sealed class ResetModel
    {
        [Required]
        [StringLength(100, ErrorMessage = "The {0} must be at least {2} and at max {1} characters long.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "New Password")]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm Password")]
        [Compare("NewPassword", ErrorMessage = "The passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
