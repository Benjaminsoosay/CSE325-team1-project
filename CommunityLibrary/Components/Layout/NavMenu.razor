@rendermode InteractiveServer
@implements IDisposable
@inject NavigationManager NavigationManager

<nav class="navbar navbar-expand-md navbar-dark bg-primary shadow-sm px-3">
    <div class="container-fluid">

        <!-- Brand Logo and Name -->
        <a class="navbar-brand d-flex align-items-center gap-2" href="">
            <img src="images/logo.png" 
                 alt="Community Library Logo" 
                 class="brand-logo" 
                 width="32" 
                 height="32"
                 onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'32\' height=\'32\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'white\' stroke-width=\'2\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><path d=\'M4 19.5A2.5 2.5 0 0 1 6.5 17H20\'/><path d=\'M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\'/></svg>';" />
            <span class="fw-bold fs-5 text-white">Community Library</span>
        </a>
        
        <button class="navbar-toggler" 
                type="button" 
                @onclick="ToggleNavMenu" 
                aria-expanded="@(!collapseNavMenu)" 
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="@NavMenuCssClass navbar-collapse" @onclick="CollapseMenuOnMobile">
            <ul class="navbar-nav ms-auto mb-2 mb-md-0 gap-md-2 align-items-md-center">
                
                <li class="nav-item">
                    <NavLink class="nav-link text-white rounded px-3 py-2 d-flex align-items-center" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-house-door-fill me-2" aria-hidden="true"></i> 
                        <span>Home</span>
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link text-white rounded px-3 py-2 d-flex align-items-center" href="catalog">
                        <i class="bi bi-book-fill me-2" aria-hidden="true"></i> 
                        <span>Catalog</span>
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link text-white rounded px-3 py-2 d-flex align-items-center" href="authors">
                        <i class="bi bi-person-fill me-2" aria-hidden="true"></i> 
                        <span>Authors</span>
                    </NavLink>
                </li>

                <li class="nav-item ms-md-2">
                    <AuthorizeView>
                        <Authorized>
                            <NavLink class="btn btn-outline-light px-3 py-2 me-2" href="dashboard">
                                My Account
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>
                </li>

                <li class="nav-item ms-md-2">
                    <AuthorizeView>
                        <Authorized>
                            <form action="Account/Logout" method="post" class="d-inline">                                             
                                <AntiforgeryToken />                                                                                  
                                <input type="hidden" name="ReturnUrl" value="@currentUrl" />                                          
                                <button type="submit" class="btn btn-outline-light px-3 py-2">                                        
                                    Log out                                                                                           
                                </button>                                                                                             
                            </form>                                                                                                   
                        </Authorized>                                                                                                 
                        <NotAuthorized>                                                                                              
                            <NavLink class="btn btn-outline-light px-3 py-2" href="Account/Login">
                                Log in                                                                                                
                            </NavLink>                                                                                                
                        </NotAuthorized>                                                                                              
                    </AuthorizeView>                                                                                                  
                </li>

            </ul>
        </div>
    </div>
</nav>

@code {
    private bool collapseNavMenu = true;
    private string? currentUrl;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : "collapse show";

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void CollapseMenuOnMobile()
    {
        if (!collapseNavMenu)
        {
            collapseNavMenu = true;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}