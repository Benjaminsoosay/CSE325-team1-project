@implements IDisposable
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JS


<div class="library-navbar">
    <div class="library-navbar-inner">

        <!-- Logo -->
        <NavLink class="library-brand" href="" Match="NavLinkMatch.All">
            <svg class="library-logo" viewBox="0 0 80 64" aria-hidden="true">
                <path d="M8 12C20 7 32 9 40 17V58C30 51 19 50 8 55V12Z" />
                <path d="M40 17C48 9 60 7 72 12V55C61 50 50 51 40 58V17Z" />
                <path d="M40 17V58" />
            </svg>

            <div class="library-brand-text">
                <span class="library-brand-name">CommunityLibrary</span>
                <span class="library-brand-tagline">
                    READ • LEARN • GROW
                </span>
            </div>
        </NavLink>

        <!-- Desktop Navigation -->
        <nav class="library-main-nav">

            <NavLink class="library-nav-link"
                     href=""
                     Match="NavLinkMatch.All">
                <span class="bi bi-house-door" aria-hidden="true"></span>
                Home
            </NavLink>

            <NavLink class="library-nav-link"
                     href="catalog">
                <span class="bi bi-book" aria-hidden="true"></span>
                Catalog
            </NavLink>

            <NavLink class="library-nav-link"
                     href="my-loans">
                <span class="bi bi-journal-bookmark" aria-hidden="true"></span>
                My Loans
            </NavLink>

            <NavLink class="library-nav-link"
                     href="reservations">
                <span class="bi bi-calendar-check" aria-hidden="true"></span>
                Reservations
            </NavLink>

            <NavLink class="library-nav-link"
                     href="about">
                <span class="bi bi-info-circle" aria-hidden="true"></span>
                About
            </NavLink>

        </nav>

        <!-- Right Side -->
        <div class="library-navbar-actions">

            <!-- Search -->
            <div class="library-search">
                <span class="bi bi-search" aria-hidden="true"></span>

                <input type="search"
                       placeholder="Search books, authors, subjects..."
                       aria-label="Search books" />
            </div>

            <!-- Notifications -->
            <button class="library-icon-button"
                    type="button"
                    aria-label="Notifications">
                <span class="bi bi-bell" aria-hidden="true"></span>
                <span class="library-notification-dot"></span>
            </button>

            <AuthorizeView>
                <Authorized>

                    <!-- Account -->
                    <NavLink class="library-account"
                             href="Account/Manage">

                        <span class="library-avatar">
                            M
                        </span>

                        <span class="library-account-info">
                            <strong>@context.User.Identity?.Name</strong>
                            <small>Library Member</small>
                        </span>

                        <span class="bi bi-chevron-down library-account-chevron"
                              aria-hidden="true">
                        </span>

                    </NavLink>

                </Authorized>

                <NotAuthorized>

                    <div class="library-auth-actions">

                        <NavLink class="library-login"
                                 href="Account/Login">
                            Login
                        </NavLink>

                        <NavLink class="library-register"
                                 href="Account/Register">
                            Register
                        </NavLink>

                    </div>

                </NotAuthorized>
            </AuthorizeView>

        </div>

        <!-- Mobile Toggle -->
        <input type="checkbox"
               title="Navigation menu"
               class="library-navbar-toggler"/>

        <label class="library-mobile-toggle"
               aria-label="Toggle navigation" onclick="@HandleToggle" >
            <span></span>
            <span></span>
            <span></span>
        </label>

    </div>
</div>

@if (clicked)
{
    <!-- Mobile Navigation -->
    <div class="library-mobile-nav"
        onclick="document.querySelector('.library-navbar-toggler').click()">

        <nav class="library-mobile-nav-inner">

            <NavLink class="library-mobile-link"
                    href=""
                    Match="NavLinkMatch.All">
                <span class="bi bi-house-door"></span>
                Home
            </NavLink>

            <NavLink class="library-mobile-link"
                    href="catalog">
                <span class="bi bi-book"></span>
                Catalog
            </NavLink>

            <NavLink class="library-mobile-link"
                    href="my-loans">
                <span class="bi bi-journal-bookmark"></span>
                My Loans
            </NavLink>

            <NavLink class="library-mobile-link"
                    href="reservations">
                <span class="bi bi-calendar-check"></span>
                Reservations
            </NavLink>

            <NavLink class="library-mobile-link"
                    href="about">
                <span class="bi bi-info-circle"></span>
                About
            </NavLink>

            <AuthorizeView>
                <Authorized>

                    <NavLink class="library-mobile-link"
                            href="Account/Manage">
                        <span class="bi bi-person-circle"></span>
                        @context.User.Identity?.Name
                    </NavLink>

                    <div class="library-mobile-logout">

                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />

                            <input type="hidden"
                                name="ReturnUrl"
                                value="@currentUrl" />

                            <button type="submit"
                                    class="library-mobile-link library-logout-button">

                                <span class="bi bi-box-arrow-right"></span>
                                Logout

                            </button>
                        </form>

                    </div>

                </Authorized>

                <NotAuthorized>

                    <NavLink class="library-mobile-link"
                            href="Account/Register">
                        <span class="bi bi-person-plus"></span>
                        Register
                    </NavLink>

                    <NavLink class="library-mobile-link"
                            href="Account/Login">
                        <span class="bi bi-box-arrow-in-right"></span>
                        Login
                    </NavLink>

                </NotAuthorized>
            </AuthorizeView>

        </nav>

    </div>    
}


@code {
    private string? currentUrl;
    private bool clicked=false;
    protected async Task HandleToggle()
    {
        @* await JS.InvokeVoidAsync("alert", "Hello u clicked me"); *@
        clicked = !clicked;
    }

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

}



