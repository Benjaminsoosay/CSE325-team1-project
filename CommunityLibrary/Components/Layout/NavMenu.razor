@implements IDisposable
@rendermode InteractiveServer

@using CommunityLibrary.Data;
@using CommunityLibrary.Models
@using CommunityLibrary.Services
@* @using Microsoft.EntityFrameworkCore *@

@inject BookService BookService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div class="library-navbar">
    <div class="library-navbar-inner">

        <!-- Logo -->
        <NavLink class="library-brand" href="" Match="NavLinkMatch.All">
            <svg class="library-logo" viewBox="0 0 80 64" aria-hidden="true">
                <path d="M8 12C20 7 32 9 40 17V58C30 51 19 50 8 55V12Z" />
                <path d="M40 17C48 9 60 7 72 12V55C61 50 50 51 40 58V17Z" />
                <path d="M40 17V58" />
            </svg>

            <div class="library-brand-text">
                <span class="library-brand-name">CommunityLibrary</span>
                <span class="library-brand-tagline">
                    READ • LEARN • GROW
                </span>
            </div>
        </NavLink>

        <!-- Desktop Navigation -->
        <nav class="library-main-nav">

            <NavLink class="library-nav-link"
                     href=""
                     Match="NavLinkMatch.All">
                @* <span class="bi bi-house-door" aria-hidden="true"></span> *@
                Home
            </NavLink>

            <NavLink class="library-nav-link"
                     href="catalog">
                @* <span class="bi bi-book" aria-hidden="true"></span> *@
                Catalog
            </NavLink>

            <NavLink class="library-nav-link"
                     href="my-borrowed">
                @* <span class="bi bi-journal-bookmark" aria-hidden="true"></span> *@
                My Loans
            </NavLink>

            <NavLink class="library-nav-link"
                     href="reservations">
                @* <span class="bi bi-calendar-check" aria-hidden="true"></span> *@
                Reservations
            </NavLink>

            <NavLink class="library-nav-link"
                     href="about">
                @* <span class="material-symbols-outlined me-2" aria-hidden="true">circle</span> *@
                About
            </NavLink>

        </nav>

        <!-- Right Side -->
        <div class="library-navbar-actions">

            <!-- Search -->
            <div class="library-search">
                <span class="material-symbols-outlined me-2" aria-hidden="true">search</span>
                <form @onsubmit="GetBooks" @onsubmit:preventDefault>
                    <input type="search" @onclick="GetBooks"
                        placeholder="Search books, authors, subjects..."
                        aria-label="Search books" @bind="searchText" @bind:event="oninput"/>
                </form>
            </div>

            <!-- Notifications -->
            <button class="library-icon-button"
                    type="button"
                    aria-label="Notifications">
                <span class="material-symbols-outlined" aria-hidden="true">notifications</span>
                <span class="library-notification-dot"></span>
            </button>

            <AuthorizeView>
                <Authorized>

                    <!-- Account -->
                    <NavLink class="library-account"
                             href="dashboard">

                        <span class="library-avatar material-symbols-outlined me-2">
                            person
                        </span>

                        <span class="library-account-info">
                            <strong>@context.User.Identity?.Name</strong>
                            <small>Library Member</small>
                        </span>
                    </NavLink>
                    <form action="Account/Logout" method="post" class="d-none d-md-block">
                            <AntiforgeryToken />

                            <input type="hidden"
                                name="ReturnUrl"
                                value="@currentUrl" />

                            <button type="submit" class="library-icon-button" title="Log out">
                                <span class="material-symbols-outlined">logout</span>
                            </button>
                    </form>
                </Authorized>

                <NotAuthorized>

                    <div class="library-auth-actions">

                        <NavLink class="library-login"
                                 href="Account/Login">
                            Login
                        </NavLink>

                        <NavLink class="library-register"
                                 href="Account/Register">
                            Register
                        </NavLink>

                    </div>

                </NotAuthorized>
            </AuthorizeView>

        </div>

        <!-- Mobile Toggle -->
        <input type="checkbox"
               title="Navigation menu"
               class="library-navbar-toggler"/>

        <label class="library-mobile-toggle"
               aria-label="Toggle navigation" onclick="@HandleToggle" >
            <span></span>
            <span></span>
            <span></span>
        </label>

    </div>
</div>


@if (clicked)
{
    <!-- Mobile Navigation -->
    <div class="library-mobile-nav"
        onclick="document.querySelector('.library-navbar-toggler').click()">

        <nav @onclick="HandleToggle" class="library-mobile-nav-inner">

            <NavLink class="library-mobile-link"
                    href=""
                    Match="NavLinkMatch.All">
                Home
            </NavLink>

            <NavLink class="library-mobile-link"
                    href="catalog">
                Catalog
            </NavLink>

            <NavLink class="library-mobile-link"
                    href="my-borrowed">
                My Loans
            </NavLink>

            <NavLink class="library-mobile-link" href="reservations">
                Reservations
            </NavLink>

            <NavLink class="library-mobile-link" href="about">
                About
            </NavLink>

            <AuthorizeView>
                <Authorized>

                    <NavLink class="library-mobile-link"
                            href="dashboard">
                        <span class="material-symbols-outlined me-2">person</span>
                        @context.User.Identity?.Name
                    </NavLink>

                    <div class="library-mobile-logout">

                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />

                            <input type="hidden"
                                name="ReturnUrl"
                                value="@currentUrl" />

                            <button type="submit"
                                    class="library-mobile-link library-logout-button">

                                <span class="material-symbols-outlined me-2">logout</span>
                                Logout

                            </button>
                        </form>

                    </div>

                </Authorized>

                <NotAuthorized>

                    <NavLink class="library-mobile-link"
                            href="Account/Register">
                        <span class="bi bi-person-plus"></span>
                        Register
                    </NavLink>

                    <NavLink class="library-mobile-link"
                            href="Account/Login">
                        <span class="bi bi-box-arrow-in-right"></span>
                        Login
                    </NavLink>

                </NotAuthorized>
            </AuthorizeView>

        </nav>

    </div>    
}

@if (!string.IsNullOrWhiteSpace(searchText))
{
    <div class="search-results">
        @foreach (var book in filteredBooks.Take(5))
        {
            <a class="search-result-item" @onclick="()=> searchText=string.Empty"
                href="@($"/book-details/{book.Id}")">

                <img class="search-result-cover"
                        src="@book.CoverImageUrl"
                        alt="" />

                <div class="search-result-info">
                    <span class="search-result-title">
                        @book.Title
                    </span>

                    <span class="search-result-author">
                        @book.Author
                    </span>

                    <span class="search-result-status">
                        @(book.AvailableCopies > 0
                            ? "Available"
                            : "Currently unavailable")
                    </span>
                </div>

                <span class="material-symbols-outlined result-arrow">
                    arrow_forward
                </span>
            </a>
        }

        @if (!filteredBooks.Any())
        {
            <div class="search-empty">
                <span class="material-symbols-outlined">
                    search_off
                </span>
                <span>No books found</span>
            </div>
        }

        <button class="search-view-all"
                @onclick="ViewAllResults">
            View all results
            <span class="material-symbols-outlined">
                arrow_outward
            </span>
        </button>
    </div>
}

@* @if(filteredBooks is not null)
{
    @foreach(Book b in filteredBooks)
    {
        <a href="/catalog/@b.Id">
            <p>@b.Title</p>
            <p>@b.Author</p>
        </a>
    }    
} *@

@code {
    private string? currentUrl;
    private bool clicked=false;

    private string searchText = "";
    protected async Task HandleToggle()
    {
        @* await JS.InvokeVoidAsync("alert", "Hello u clicked me"); *@
        clicked = !clicked;
    }

    private List<Book> Books = new();
    
    @* private readonly ApplicationDbContext _context; *@


    private async Task GetBooks()
    {
        @* if(Books is null)
        { *@
            Books = await BookService.GetBookByTitleAsync(searchText);
        @* }
        if(searchText.Count() > 2)
        {
            filteredBooks = Books.AsEnumerable().Where(b=> b.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) || b.Author.Contains(searchText, StringComparison.OrdinalIgnoreCase));   
        }
        else
        {
            filteredBooks = null;
        } *@
    } 
    private IEnumerable<Book> filteredBooks
    {
        get
        {
            var query = searchText?.Trim();

            if (string.IsNullOrWhiteSpace(query))
                return Books;

            return Books.Where(book =>
                book.Title.Contains(
                    query,
                    StringComparison.OrdinalIgnoreCase)
                ||
                book.Author.Contains(
                    query,
                    StringComparison.OrdinalIgnoreCase)
                ||
                (book.Category?.Name?.Contains(
                    query,
                    StringComparison.OrdinalIgnoreCase) ?? false)
            );
        }
    }

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void ViewAllResults()
    {
        NavigationManager.NavigateTo($"/catalog?search={Uri.EscapeDataString(searchText)}");
    }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

}