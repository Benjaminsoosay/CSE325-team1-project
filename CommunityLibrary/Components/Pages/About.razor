@page "/about"


<PageTitle>About Us - Community Library</PageTitle>

<HeadContent>
    <meta name="description" content="Learn about Community Library's mission to foster literacy, shared learning, and accessible book borrowing in our neighborhood." />
    <meta property="og:title" content="About Us - Community Library" />
    <meta property="og:description" content="Fostering a culture of shared learning, literacy, and connection in our neighborhood." />
    <meta property="og:type" content="website" />
</HeadContent>

<main>

    <section class="container my-5" aria-label="Core Pillars">
        <div class="row text-center">
            <div class="col-md-4 mb-4">
                <article class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="feature-icon bg-primary bg-gradient text-white rounded-circle mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;" aria-hidden="true">
                            <span class="fs-3">🎯</span>
                        </div>
                        <h2 class="card-title h4 fw-bold">Our Mission</h2>
                        <p class="card-text text-muted">Connecting readers across our community through accessible physical books, digital borrowing, and active learning spaces.</p>
                    </div>
                </article>
            </div>
            <div class="col-md-4 mb-4">
                <article class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="feature-icon bg-success bg-gradient text-white rounded-circle mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;" aria-hidden="true">
                            <span class="fs-3">🔄</span>
                        </div>
                        <h2 class="card-title h4 fw-bold">Shared Resource Model</h2>
                        <p class="card-text text-muted">Eliminating barriers to knowledge with automated loan tracking, real-time availability status, and simple book returns.</p>
                    </div>
                </article>
            </div>
            <div class="col-md-4 mb-4">
                <article class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="feature-icon bg-info bg-gradient text-white rounded-circle mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;" aria-hidden="true">
                            <span class="fs-3">🤝</span>
                        </div>
                        <h2 class="card-title h4 fw-bold">Community Driven</h2>
                        <p class="card-text text-muted">Built for readers, educators, and library members to recommend titles, join discussions, and expand our inventory.</p>
                    </div>
                </article>
            </div>
        </div>
    </section>
    <section class="bg-light py-5" aria-labelledby="cta-heading">
        <div class="container text-center">
            <h2 id="cta-heading" class="fw-bold mb-3">Want to borrow your next book?</h2>
            <p class="lead text-muted mb-4">Sign up for a free membership account and start managing your loans instantly.</p>
            <a href="/auth" class="btn btn-primary btn-lg px-5">Join the Community</a>
        </div>
    </section>
</main>