@page "/admin"
@rendermode InteractiveServer
@using CommunityLibrary.Models
@using CommunityLibrary.Services
@inject NavigationManager NavigationManager
@inject BookService BookService
@inject CategoryService CategoryService

<PageTitle>Admin Panel</PageTitle>

<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="container mt-4">
            <a href="dashboard" class="btn btn-outline-secondary mb-3">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                <h2 class="mb-0 me-auto">Manage Books</h2>
                <span class="badge bg-primary fs-6">@books.Count Books</span>
                <button class="btn btn-primary" @onclick="OpenAddModal">
                    <i class="bi bi-plus-lg me-1"></i> Add Book
                </button>
            </div>

            @if (isLoading)
            {
                <p>Loading books...</p>
            }
            else if (books.Count == 0)
            {
                <div class="alert alert-info text-center">
                    <h5>No books in the library yet</h5>
                </div>
            }
            else
            {
                <div class="d-none d-md-block">
                    <div class="card shadow-sm">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 60px;">Cover</th>
                                            <th>Title</th>
                                            <th>Author</th>
                                            <th>Category</th>
                                            <th>Copies</th>
                                            <th>Published</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var book in books)
                                        {
                                            <tr>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                                                    {
                                                        <img src="@book.CoverImageUrl" alt="@book.Title"
                                                             class="rounded" style="width: 45px; height: 60px; object-fit: cover;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                                             style="width: 45px; height: 60px;">
                                                            <i class="bi bi-book text-muted"></i>
                                                        </div>
                                                    }
                                                </td>
                                                <td><strong>@book.Title</strong></td>
                                                <td class="text-muted">@book.Author</td>
                                                <td>
                                                    <span class="badge bg-secondary">
                                                        @(book.Category?.Name ?? "—")
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="@(book.AvailableCopies > 0 ? "text-success" : "text-danger")">
                                                        @book.AvailableCopies
                                                    </span>
                                                    / @book.TotalCopies
                                                </td>
                                                <td class="text-muted">@book.PublishedDate.ToString("MMM yyyy")</td>
                                                <td class="text-end">
                                                    <button class="btn btn-sm btn-outline-primary me-1"
                                                            @onclick="() => OpenEditModal(book)">
                                                        <i class="bi bi-pencil me-1"></i> Edit
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger"
                                                            @onclick="() => OpenDeleteModal(book)">
                                                        <i class="bi bi-trash me-1"></i> Delete
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-md-none">
                    <div class="row g-3">
                        @foreach (var book in books)
                        {
                            <div class="col-12">
                                <div class="card shadow-sm">
                                    <div class="card-body">
                                        <div class="d-flex gap-3">
                                            @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                                            {
                                                <img src="@book.CoverImageUrl" alt="@book.Title"
                                                     class="rounded" style="width: 60px; height: 80px; object-fit: cover;" />
                                            }
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1">@book.Title</h6>
                                                <p class="text-muted mb-1 small">@book.Author</p>
                                                <div class="d-flex gap-2 align-items-center mb-2">
                                                    <span class="badge bg-secondary">@(book.Category?.Name ?? "—")</span>
                                                    <span class="small">
                                                        <span class="@(book.AvailableCopies > 0 ? "text-success" : "text-danger") fw-bold">
                                                            @book.AvailableCopies
                                                        </span> / @book.TotalCopies copies
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="d-flex gap-2 mt-2">
                                            <button class="btn btn-sm btn-outline-primary flex-grow-1"
                                                    @onclick="() => OpenEditModal(book)">
                                                <i class="bi bi-pencil me-1"></i> Edit
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger flex-grow-1"
                                                    @onclick="() => OpenDeleteModal(book)">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <DeleteConfirmModal Show="showDeleteModal"
                                BookTitle="@deleteBookTitle"
                                OnClose="CloseDeleteModal"
                                OnConfirm="ConfirmDelete" />

            <BookFormModal Show="showModal"
                           IsEditing="isEditing"
                           Book="formBook"
                           Categories="categories"
                           OnClose="CloseModal"
                           OnSave="SaveBook" />
        </div>
    </Authorized>
    <NotAuthorized>
        <p>Redirecting...</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<Book> books = new();
    private List<Category> categories = new();
    private bool isLoading = true;
    private bool showModal = false;
    private bool isEditing = false;
    private Book formBook = new();
    private bool showDeleteModal = false;
    private int deleteBookId;
    private string deleteBookTitle = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            var user = authState.User;
            if (user.Identity is null || !user.Identity.IsAuthenticated || !user.IsInRole("Admin"))
            {
                NavigationManager.NavigateTo("dashboard");
                return;
            }

            await LoadBooks();
            categories = await CategoryService.GetCategoriesAsync();
            StateHasChanged();
        }
    }

    private async Task LoadBooks()
    {
        books = await BookService.GetBooksAsync();
        isLoading = false;
    }

    private void OpenAddModal()
    {
        formBook = new Book();
        isEditing = false;
        showModal = true;
    }

    private void OpenEditModal(Book book)
    {
        formBook = new Book
        {
            Id = book.Id,
            Title = book.Title,
            Author = book.Author,
            CategoryID = book.CategoryID,
            Description = book.Description,
            CoverImageUrl = book.CoverImageUrl,
            TotalCopies = book.TotalCopies,
            AvailableCopies = book.AvailableCopies,
            PublishedDate = book.PublishedDate
        };
        isEditing = true;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveBook()
    {
        if (isEditing)
            await BookService.UpdateBookAsync(formBook);
        else
            await BookService.CreateBookAsync(formBook);

        showModal = false;
        await LoadBooks();
    }

    private void OpenDeleteModal(Book book)
    {
        deleteBookId = book.Id;
        deleteBookTitle = book.Title;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
    }

    private async Task ConfirmDelete()
    {
        await BookService.DeleteBookAsync(deleteBookId);
        showDeleteModal = false;
        await LoadBooks();
    }
}
