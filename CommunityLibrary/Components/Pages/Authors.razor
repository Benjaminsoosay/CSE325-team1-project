@page "/authors"

<PageTitle>Authors - Community Library</PageTitle>

<div class="container mt-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Authors</h1>
            <p class="text-muted mb-0">Discover the brilliant minds behind our books</p>
        </div>
        <span class="badge bg-primary fs-6">@authors.Count Authors</span>
    </div>

    <!-- Author Grid -->
    <div class="row g-4">
        @foreach (var author in authors)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm text-center">
                    <div class="card-body">
                        <!-- Avatar Circle -->
                        <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 80px; height: 80px; font-size: 32px; font-weight: bold;">
                            @author.Initials
                        </div>

                        <h5 class="card-title mb-1">@author.Name</h5>
                        <p class="text-muted small mb-3">@author.Nationality • @author.BirthYear</p>
                        
                        <p class="card-text">@author.Bio</p>

                        <div class="mt-3 pt-3 border-top">
                            <span class="badge bg-secondary">
                                @author.BookCount @(author.BookCount == 1 ? "Book" : "Books")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<Author> authors = new List<Author>
    {
        new Author
        {
            Name = "F. Scott Fitzgerald",
            Nationality = "American",
            BirthYear = "1896",
            Bio = "Known for his vivid depictions of the Jazz Age, his works capture the glamour and disillusionment of the 1920s.",
            BookCount = 1
        },
        new Author
        {
            Name = "Harper Lee",
            Nationality = "American",
            BirthYear = "1926",
            Bio = "Pulitzer Prize-winning author best known for her novel about racial injustice in the American South.",
            BookCount = 1
        },
        new Author
        {
            Name = "George Orwell",
            Nationality = "British",
            BirthYear = "1903",
            Bio = "Novelist and essayist famous for his sharp critiques of totalitarianism and social injustice.",
            BookCount = 1
        },
        new Author
        {
            Name = "Jane Austen",
            Nationality = "British",
            BirthYear = "1775",
            Bio = "Renowned for her romantic fiction that critiques the social norms of 18th-century England.",
            BookCount = 1
        },
        new Author
        {
            Name = "J.R.R. Tolkien",
            Nationality = "British",
            BirthYear = "1892",
            Bio = "The father of modern fantasy literature and creator of the beloved Middle-earth universe.",
            BookCount = 1
        },
        new Author
        {
            Name = "Ray Bradbury",
            Nationality = "American",
            BirthYear = "1920",
            Bio = "Acclaimed science fiction writer known for poetic prose and cautionary tales of technology.",
            BookCount = 1
        }
    };

    public class Author
    {
        public string Name { get; set; } = string.Empty;
        public string Nationality { get; set; } = string.Empty;
        public string BirthYear { get; set; } = string.Empty;
        public string Bio { get; set; } = string.Empty;
        public int BookCount { get; set; }

        public string Initials
        {
            get
            {
                if (string.IsNullOrWhiteSpace(Name)) return "?";
                var parts = Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
                return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
            }
        }
    }
}