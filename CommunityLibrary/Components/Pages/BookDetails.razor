@page "/book-details/{Id:int}"

@using System.Security.Claims
@using CommunityLibrary.Models
@using CommunityLibrary.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject BookService BookService
@inject LoanService LoanService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>
    @(book is null ? "Book Details" : $"{book.Title} | CommunityLibrary")
    <style>
        
    </style>
</PageTitle>

<div class="book-details-page">

    <a href="/catalog" class="back-link">
        <span class="material-symbols-outlined">arrow_back</span>
        Back to catalog
    </a>

    @if (isLoading)
    {
        <div class="details-loader">
            <div class="loader-spinner"></div>
            <p>Loading book details...</p>
        </div>
    }
    else if (book is null)
    {
        <div class="details-empty">
            <span class="material-symbols-outlined">menu_book</span>
            <h2>Book not found</h2>
            <p>This book may have been removed or the link is invalid.</p>
            <a href="/catalog" class="details-primary-btn">
                Browse catalog
            </a>
        </div>
    }
    else
    {
        <div class="book-details-layout">

            <div class="book-cover-panel">
                @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl))
                {
                    <img src="@book.CoverImageUrl"
                         alt="Cover of @book.Title"
                         class="book-cover-image" />
                }
                else
                {
                    <div class="book-cover-placeholder">
                        <span class="material-symbols-outlined">
                            menu_book
                        </span>
                    </div>
                }
            </div>

            <div class="book-information">

                @if (book.Category is not null)
                {
                    <span class="book-category">
                        @book.Category.Name
                    </span>
                }

                <h1>@book.Title</h1>

                <p class="book-author">
                    By @book.Author
                </p>

                <div class="book-availability">
                    <span class="material-symbols-outlined">
                        @(book.AvailableCopies > 0
                            ? "check_circle"
                            : "cancel")
                    </span>

                    @if (book.AvailableCopies > 0)
                    {
                        <span>
                            Available to borrow
                            (@book.AvailableCopies
                            @(book.AvailableCopies == 1 ? "copy" : "copies"))
                        </span>
                    }
                    else
                    {
                        <span>Currently unavailable</span>
                    }
                </div>

                <div class="book-details-divider"></div>

                <h2>About this book</h2>

                @if (!string.IsNullOrWhiteSpace(book.Description))
                {
                    <p class="book-description">
                        @book.Description
                    </p>
                }
                else
                {
                    <p class="book-description">
                        No description is available for this book yet.
                    </p>
                }

                <div class="book-metadata">
                    <div>
                        <span class="metadata-label">Author</span>
                        <span class="metadata-value">@book.Author</span>
                    </div>

                    <div>
                        <span class="metadata-label">Category</span>
                        <span class="metadata-value">
                            @(book.Category?.Name ?? "Uncategorized")
                        </span>
                    </div>

                    <div>
                        <span class="metadata-label">Published</span>
                        <span class="metadata-value">
                            @book.PublishedDate.ToString("MMMM d, yyyy")
                        </span>
                    </div>

                    <div>
                        <span class="metadata-label">Total copies</span>
                        <span class="metadata-value">@book.TotalCopies</span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <div class="details-message @(borrowSucceeded
                        ? "message-success" : "message-error")"
                         role="status">
                        @message
                    </div>
                }

                <div class="book-actions">

                    @if (book.AvailableCopies > 0)
                    {
                        <AuthorizeView>
                            <Authorized>
                                <button class="details-primary-btn"
                                        disabled="@isBorrowing"
                                        @onclick="BorrowBook">
                                    <span class="material-symbols-outlined">
                                        library_add
                                    </span>
                                    @(isBorrowing ? "Processing..." : "Borrow book")
                                </button>
                            </Authorized>

                            <NotAuthorized>
                                <button class="details-primary-btn"
                                        @onclick="GoToLogin">
                                    <span class="material-symbols-outlined">
                                        login
                                    </span>
                                    Login to borrow
                                </button>
                            </NotAuthorized>
                        </AuthorizeView>
                    }
                    else
                    {
                        <button class="details-primary-btn" disabled>
                            Currently unavailable
                        </button>
                    }

                </div>

                <p class="loan-note">
                    Standard loan period: 14 days.
                </p>

            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Book? book;
    private bool isLoading = true;
    private bool isBorrowing;
    private bool borrowSucceeded;
    private string? message;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        message = null;
        book = await BookService.GetBookByIdAsync(Id);
        isLoading = false;
    }

    private void GoToLogin()
    {
        var returnUrl = Uri.EscapeDataString($"/book-details/{Id}");

        NavigationManager.NavigateTo(
            $"/Account/Login?returnUrl={returnUrl}");
    }

    private async Task BorrowBook()
    {
        if (book is null || isBorrowing)
            return;

        isBorrowing = true;
        message = null;

        try
        {
            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                GoToLogin();
                return;
            }

            var userId = user.FindFirst(
                ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrWhiteSpace(userId))
            {
                message = "Unable to identify your account. Please sign in again.";
                borrowSucceeded = false;
                return;
            }

            var result = await LoanService.BorrowBookAsync(
                book.Id,
                userId);

            message = result.Message;
            borrowSucceeded = result.Success;

            if (result.Success)
            {
                // Reload the book to display its updated copy count.
                book = await BookService.GetBookByIdAsync(Id);
            }
        }
        catch
        {
            message = "Something went wrong while borrowing this book. Please try again.";
            borrowSucceeded = false;
        }
        finally
        {
            isBorrowing = false;
        }
    }
}