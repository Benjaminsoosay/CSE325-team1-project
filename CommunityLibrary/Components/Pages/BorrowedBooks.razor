@page "/my-borrowed"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<PageTitle>My Borrowed Books - Community Library</PageTitle>

<AuthorizeView>
<Authorized>
<div class="container mt-4">
    <a href="dashboard" class="btn btn-outline-secondary mb-3">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">My Borrowed Books</h1>
            <p class="text-muted mb-0">Track your current loans and due dates</p>
        </div>
        <span class="badge bg-primary fs-6">@borrowedBooks.Count Active Loans</span>
    </div>

    <!-- Alert for overdue books -->
    @if (OverdueCount > 0)
    {
        <div class="alert alert-danger d-flex align-items-center" role="alert">
            <strong>⚠️ You have @OverdueCount overdue @(OverdueCount == 1 ? "book" : "books")!</strong>
            <span class="ms-2">Please return them as soon as possible.</span>
        </div>
    }

    @if (borrowedBooks.Count == 0)
    {
        <!-- Empty State -->
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h4 class="mb-3">No books borrowed yet</h4>
                <p class="text-muted mb-4">Start exploring our catalog and borrow your first book!</p>
                <a href="/catalog" class="btn btn-primary">Browse Catalog</a>
            </div>
        </div>
    }
    else
    {
        <!-- Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm border-start border-primary border-4">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase small">Total Borrowed</h6>
                        <h2 class="mb-0">@borrowedBooks.Count</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-start border-success border-4">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase small">On Time</h6>
                        <h2 class="mb-0">@(borrowedBooks.Count - OverdueCount)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-start border-danger border-4">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase small">Overdue</h6>
                        <h2 class="mb-0">@OverdueCount</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Borrowed Books List -->
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" style="width: 80px;">Cover</th>
                                <th scope="col">Title</th>
                                <th scope="col">Author</th>
                                <th scope="col">Borrowed On</th>
                                <th scope="col">Due Date</th>
                                <th scope="col">Status</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var loan in borrowedBooks)
                            {
                                <tr>
                                    <td>
                                        <img src="@loan.CoverImageUrl" alt="@loan.Title"
                                             class="rounded" style="width: 50px; height: 70px; object-fit: cover;" />
                                    </td>
                                    <td><strong>@loan.Title</strong></td>
                                    <td class="text-muted">@loan.Author</td>
                                    <td>@loan.BorrowedDate.ToString("MMM dd, yyyy")</td>
                                    <td>@loan.DueDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (loan.IsOverdue)
                                        {
                                            <span class="badge bg-danger">Overdue</span>
                                        }
                                        else if (loan.DaysRemaining <= 3)
                                        {
                                            <span class="badge bg-warning text-dark">Due Soon</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">On Time</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary me-1">Renew</button>
                                        <button class="btn btn-sm btn-outline-danger">Return</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

</Authorized>
<NotAuthorized>
    <p>Redirecting...</p>
</NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            if (authState.User.Identity is null || !authState.User.Identity.IsAuthenticated)
            {
                NavigationManager.NavigateTo("Account/Login?ReturnUrl=%2Fmy-borrowed");
            }
        }
    }
    private List<BorrowedBook> borrowedBooks = new List<BorrowedBook>
    {
        new BorrowedBook
        {
            Id = 1,
            Title = "The Great Gatsby",
            Author = "F. Scott Fitzgerald",
            CoverImageUrl = "https://covers.openlibrary.org/b/isbn/9780743273565-L.jpg",
            BorrowedDate = DateTime.Today.AddDays(-10),
            DueDate = DateTime.Today.AddDays(4)
        },
        new BorrowedBook
        {
            Id = 3,
            Title = "1984",
            Author = "George Orwell",
            CoverImageUrl = "https://covers.openlibrary.org/b/isbn/9780451524935-L.jpg",
            BorrowedDate = DateTime.Today.AddDays(-20),
            DueDate = DateTime.Today.AddDays(-6)
        },
        new BorrowedBook
        {
            Id = 5,
            Title = "The Hobbit",
            Author = "J.R.R. Tolkien",
            CoverImageUrl = "https://covers.openlibrary.org/b/isbn/9780547928227-L.jpg",
            BorrowedDate = DateTime.Today.AddDays(-2),
            DueDate = DateTime.Today.AddDays(12)
        }
    };

    private int OverdueCount => borrowedBooks.Count(b => b.IsOverdue);

    public class BorrowedBook
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Author { get; set; } = string.Empty;
        public string CoverImageUrl { get; set; } = string.Empty;
        public DateTime BorrowedDate { get; set; }
        public DateTime DueDate { get; set; }

        public bool IsOverdue => DateTime.Today > DueDate;
        public int DaysRemaining => (DueDate - DateTime.Today).Days;
    }
}