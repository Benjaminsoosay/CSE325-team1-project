@page "/catalog"
@rendermode InteractiveServer

@using System.Data.Common
@using CommunityLibrary.Data
@using CommunityLibrary.Models
@using Microsoft.EntityFrameworkCore
@using CommunityLibrary.Services

@inject ApplicationDbContext Db
@inject BookService BookServices

<PageTitle>Library Catalog</PageTitle>

<div class="container-fluid px-4 py-4">

    <!-- =====================================================
         CATALOG HEADER
         ===================================================== -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                Discover Great Books
            </h1>

            <p class="text-secondary mb-0">
                Browse our collection and find your next book.
            </p>
        </div>

        <div class="mt-3 mt-md-0">

            <div class="input-group">
                <span class="input-group-text bg-white">
                    <i class="bi bi-search"></i>
                </span>

                <input class="form-control"
                       placeholder="Search catalog..."
                       @bind="searchTerm"
                       @bind:event="oninput" />

            </div>

        </div>

    </div>


    <div class="row g-4">

        <!-- =================================================
             SIDEBAR
             ================================================= -->

        <aside class="col-lg-3 col-xl-2">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <!-- Categories -->

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h6 class="fw-bold mb-0">
                            Categories
                        </h6>

                        <i class="bi bi-chevron-up"></i>

                    </div>


                    <div class="list-group list-group-flush">

                        <button class="list-group-item list-group-item-action border-0 px-0
                                       @(selectedCategory == "All" ? "text-primary fw-semibold" : "")"
                                @onclick='() => SelectCategory("All")'>

                            <div class="d-flex justify-content-between">

                                <span>
                                    <i class="bi bi-collection me-2"></i>
                                    All Books
                                </span>

                                <span class="text-secondary">
                                    @Books.Count
                                </span>

                            </div>

                        </button>


                        @foreach (var category in Categories)
                        {
                            <button class="list-group-item list-group-item-action border-0 px-0
                                           @(selectedCategory == category.Name ? "text-primary fw-semibold" : "")"
                                    @onclick='() => SelectCategory(category.Name)'>

                                <div class="d-flex justify-content-between">

                                    <span>
                                        <i class="bi bi-book me-2"></i>
                                        @category.Name
                                    </span>

                                    <span class="text-secondary">
                                        @Books.Count(b => b.CategoryID == category.Id)
                                    </span>

                                </div>

                            </button>
                        }

                    </div>


                    <hr class="my-4" />


                    <!-- Availability -->

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h6 class="fw-bold mb-0">
                            Availability
                        </h6>

                        <i class="bi bi-chevron-up"></i>

                    </div>


                    <div class="form-check mb-2">

                        <input class="form-check-input"
                               type="checkbox"
                               id="availableFilter"
                               @bind="availableOnly" />

                        <label class="form-check-label"
                               for="availableFilter">

                            Available Now

                        </label>

                    </div>


                    <div class="form-check mb-2">

                        <input class="form-check-input"
                               type="checkbox"
                               id="loanFilter"
                               @bind="onLoanOnly" />

                        <label class="form-check-label"
                               for="loanFilter">

                            On Loan

                        </label>

                    </div>


                    <div class="form-check">

                        <input class="form-check-input"
                               type="checkbox"
                               id="reservedFilter"
                               @bind="reservedOnly" />

                        <label class="form-check-label"
                               for="reservedFilter">

                            Reserved

                        </label>

                    </div>


                    <hr class="my-4" />


                    <!-- Format -->

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h6 class="fw-bold mb-0">
                            Format
                        </h6>

                        <i class="bi bi-chevron-up"></i>

                    </div>


                    <div class="form-check mb-2">

                        <input class="form-check-input"
                               type="checkbox"
                               id="physicalFilter" />

                        <label class="form-check-label"
                               for="physicalFilter">

                            Physical Book

                        </label>

                    </div>


                    <div class="form-check">

                        <input class="form-check-input"
                               type="checkbox"
                               id="ebookFilter" />

                        <label class="form-check-label"
                               for="ebookFilter">

                            E-Book

                        </label>

                    </div>

                </div>

            </div>

        </aside>


        <!-- =================================================
             CATALOG CONTENT
             ================================================= -->

        <main class="col-lg-9 col-xl-10">


            <!-- Result / Sort -->

            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

                <div>

                    <span class="text-secondary">
                        Showing
                    </span>

                    <strong>
                        @Books.Count()
                    </strong>

                    <span class="text-secondary">
                        books
                    </span>

                </div>


                <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">

                    <span class="text-secondary small">
                        Sort by:
                    </span>

                    <select class="form-select form-select-sm"
                            style="width: 160px;"
                            @bind="sortOption">

                        <option value="title" @onclick="Sort">
                            Title (A-Z)
                        </option>

                        <option value="author">
                            Author
                        </option>

                        <option value="available">
                            Availability
                        </option>

                    </select>

                </div>

            </div>


            <!-- =================================================
                 BOOK GRID
                 ================================================= -->

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-xl-3 row-cols-xxl-4 g-4">
                @foreach (var book in Books)
                {
                    <div class="col-md-4 col-lg-3 mb-4">
                        <div class="card h-100 shadow-sm">

                            @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                            {
                                <img src="@book.CoverImageUrl"
                                    class="card-img-top"
                                    alt="@book.Title"
                                    style="height: 280px; object-fit: cover;" />
                            }

                            <div class="card-body">
                                <h5 class="card-title">@book.Title</h5>

                                <p class="card-text text-muted">
                                    @book.Author
                                </p>

                                <span class="badge bg-primary">
                                    @book.Category
                                </span>

                                <p class="mt-2">
                                    Available:
                                    <strong>@book.AvailableCopies</strong>
                                    / @book.TotalCopies
                                </p>

                                @if (book.AvailableCopies > 0)
                                {
                                    <button class="btn btn-primary">
                                        Borrow
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-secondary">
                                        Reserve
                                    </button>
                                }
                            </div>

                        </div>
                    </div>
                }
            </div>


        </main>

    </div>

</div>


@code {

    // =====================================================
    // BOOK MODEL
    // =====================================================
@* 
    public class Book
    {
        public int Id { get; set; }

        public string Title { get; set; } = "";

        public string Author { get; set; } = "";

        public string Category { get; set; } = "";

        public string CoverColor { get; set; } = "primary";

        public BookStatus Status { get; set; }

        public int AvailableCopies { get; set; }

        public DateTime? DueDate { get; set; }
    }
 *@

    // =====================================================
    // BOOK STATUS
    // =====================================================

    @* public enum BookStatus
    {
        Available,
        OnLoan,
        Reserved
    }
 *@

    // =====================================================
    // DUMMY BOOK DATA
    // =====================================================

    private List<Book> Books = new();
    private List<Category> Categories = new();

    protected override async Task OnInitializedAsync()
    {
        @* BookService bookService = new(); *@
        Books = await BookServices.GetBooksAsync();
        Categories = await Db.Categories.OrderBy(b => b.Name).ToListAsync();
        Console.WriteLine(Books);
    }

    // =====================================================
    // FILTER STATE
    // =====================================================

    private string searchTerm = "";

    private string selectedCategory = "All";

    private bool availableOnly = false;

    private bool onLoanOnly = false;

    private bool reservedOnly = false;

    private string sortOption = "title";

    public void Sort()
    {
        if(sortOption == "available")
            Books.OrderBy(b => b.AvailableCopies).ToArray();
        else if(sortOption == "author")
            Books.OrderBy(b => b.Author).ToArray();
        else
            Books.OrderBy(b => b.Title).ToArray();

    }
    // =====================================================
    // FILTERED BOOKS
    // =====================================================


    // =====================================================
    // CATEGORY SELECTION
    // =====================================================


    private void SelectCategory(string category)
    {
        selectedCategory = category;
    }

}