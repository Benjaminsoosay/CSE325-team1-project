@page "/catalog"

<PageTitle>Library Catalog</PageTitle>

<div class="container-fluid px-4 py-4">

    <!-- =====================================================
         CATALOG HEADER
         ===================================================== -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                Discover Great Books
            </h1>

            <p class="text-secondary mb-0">
                Browse our collection and find your next book.
            </p>
        </div>

        <div class="mt-3 mt-md-0">

            <div class="input-group">
                <span class="input-group-text bg-white">
                    <i class="bi bi-search"></i>
                </span>

                <input class="form-control"
                       placeholder="Search catalog..."
                       @bind="searchTerm"
                       @bind:event="oninput" />

            </div>

        </div>

    </div>


    <div class="row g-4">

        <!-- =================================================
             SIDEBAR
             ================================================= -->

        <aside class="col-lg-3 col-xl-2">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <!-- Categories -->

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h6 class="fw-bold mb-0">
                            Categories
                        </h6>

                        <i class="bi bi-chevron-up"></i>

                    </div>


                    <div class="list-group list-group-flush">

                        <button class="list-group-item list-group-item-action border-0 px-0
                                       @(selectedCategory == "All" ? "text-primary fw-semibold" : "")"
                                @onclick='() => SelectCategory("All")'>

                            <div class="d-flex justify-content-between">

                                <span>
                                    <i class="bi bi-collection me-2"></i>
                                    All Books
                                </span>

                                <span class="text-secondary">
                                    @Books.Count
                                </span>

                            </div>

                        </button>


                        @foreach (var category in Categories)
                        {
                            <button class="list-group-item list-group-item-action border-0 px-0
                                           @(selectedCategory == category ? "text-primary fw-semibold" : "")"
                                    @onclick='() => SelectCategory(category)'>

                                <div class="d-flex justify-content-between">

                                    <span>
                                        <i class="bi bi-book me-2"></i>
                                        @category
                                    </span>

                                    <span class="text-secondary">
                                        @Books.Count(b => b.Category == category)
                                    </span>

                                </div>

                            </button>
                        }

                    </div>


                    <hr class="my-4" />


                    <!-- Availability -->

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h6 class="fw-bold mb-0">
                            Availability
                        </h6>

                        <i class="bi bi-chevron-up"></i>

                    </div>


                    <div class="form-check mb-2">

                        <input class="form-check-input"
                               type="checkbox"
                               id="availableFilter"
                               @bind="availableOnly" />

                        <label class="form-check-label"
                               for="availableFilter">

                            Available Now

                        </label>

                    </div>


                    <div class="form-check mb-2">

                        <input class="form-check-input"
                               type="checkbox"
                               id="loanFilter"
                               @bind="onLoanOnly" />

                        <label class="form-check-label"
                               for="loanFilter">

                            On Loan

                        </label>

                    </div>


                    <div class="form-check">

                        <input class="form-check-input"
                               type="checkbox"
                               id="reservedFilter"
                               @bind="reservedOnly" />

                        <label class="form-check-label"
                               for="reservedFilter">

                            Reserved

                        </label>

                    </div>


                    <hr class="my-4" />


                    <!-- Format -->

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h6 class="fw-bold mb-0">
                            Format
                        </h6>

                        <i class="bi bi-chevron-up"></i>

                    </div>


                    <div class="form-check mb-2">

                        <input class="form-check-input"
                               type="checkbox"
                               id="physicalFilter" />

                        <label class="form-check-label"
                               for="physicalFilter">

                            Physical Book

                        </label>

                    </div>


                    <div class="form-check">

                        <input class="form-check-input"
                               type="checkbox"
                               id="ebookFilter" />

                        <label class="form-check-label"
                               for="ebookFilter">

                            E-Book

                        </label>

                    </div>

                </div>

            </div>

        </aside>


        <!-- =================================================
             CATALOG CONTENT
             ================================================= -->

        <main class="col-lg-9 col-xl-10">


            <!-- Result / Sort -->

            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

                <div>

                    <span class="text-secondary">
                        Showing
                    </span>

                    <strong>
                        @FilteredBooks.Count()
                    </strong>

                    <span class="text-secondary">
                        books
                    </span>

                </div>


                <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">

                    <span class="text-secondary small">
                        Sort by:
                    </span>

                    <select class="form-select form-select-sm"
                            style="width: 160px;"
                            @bind="sortOption">

                        <option value="title">
                            Title (A-Z)
                        </option>

                        <option value="author">
                            Author
                        </option>

                        <option value="available">
                            Availability
                        </option>

                    </select>

                </div>

            </div>


            <!-- =================================================
                 BOOK GRID
                 ================================================= -->

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-xl-3 row-cols-xxl-4 g-4">

                @foreach (var book in FilteredBooks)
                {
                    <div class="col">

                        <div class="card h-100 border-0 shadow-sm">

                            <!-- Book Cover -->

                            <div class="position-relative p-3">

                                <div class="bg-@book.CoverColor
                                            text-white
                                            rounded
                                            shadow-sm
                                            d-flex
                                            flex-column
                                            justify-content-between
                                            p-3"
                                     style="height: 250px;">

                                    <div>

                                        <small class="opacity-75">
                                            @book.Category
                                        </small>

                                        <h5 class="fw-bold mt-4">
                                            @book.Title
                                        </h5>

                                    </div>

                                    <small>
                                        @book.Author
                                    </small>

                                </div>


                                <!-- Bookmark -->

                                <button class="btn btn-light rounded-circle position-absolute top-0 end-0 m-3 shadow-sm"
                                        title="Save book">
                                    <i class="bi bi-bookmark"></i>
                                </button>

                            </div>


                            <!-- Book Information -->

                            <div class="card-body pt-0">

                                <h5 class="card-title fw-bold mb-1">
                                    @book.Title
                                </h5>

                                <p class="text-secondary small mb-2">
                                    @book.Author
                                </p>


                                <span class="badge bg-primary-subtle text-primary mb-3">
                                    @book.Category
                                </span>

                                <!-- Availability -->

                                @if (book.Status == BookStatus.Available)
                                {
                                    <div class="small text-success fw-semibold mb-3">
                                        <i class="bi bi-circle-fill me-1"
                                           style="font-size: 7px;">
                                        </i>
                                        Available
                                        <span class="text-secondary fw-normal">
                                            (@book.AvailableCopies copies)
                                        </span>

                                    </div>
                                }
                                else if (book.Status == BookStatus.OnLoan)
                                {
                                    <div class="small text-danger fw-semibold mb-3">
                                        <i class="bi bi-circle-fill me-1"
                                           style="font-size: 7px;">
                                        </i>
                                        On Loan
                                    </div>

                                    @if (book.DueDate.HasValue)
                                    {
                                        <div class="small text-secondary mb-3">
                                            Due:
                                            @book.DueDate.Value.ToString("MMM dd, yyyy")
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="small text-warning fw-semibold mb-3">
                                        <i class="bi bi-clock me-1"></i>
                                        Reserved
                                    </div>
                                }

                                <!-- Action -->

                                @if (book.Status == BookStatus.Available)
                                {
                                    <button class="btn btn-primary w-100" @onclick="() => BorrowBook(book)">
                                        <i class="bi bi-book me-2"></i>
                                        Borrow
                                    </button>
                                }
                                else{
                                    <button class="btn btn-outline-primary w-100" @onclick="() => ReserveBook(book)">
                                        <i class="bi bi-calendar-check me-2"></i>
                                        Reserve
                                    </button>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>


            <!-- No Results -->

            @if (!FilteredBooks.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-book display-4 text-secondary"></i>

                    <h4 class="mt-3">
                        No books found
                    </h4>

                    <p class="text-secondary">
                        Try changing your search or filters.
                    </p>

                </div>
            }

        </main>

    </div>

</div>


@code {

    // =====================================================
    // BOOK MODEL
    // =====================================================

    public class Book
    {
        public int Id { get; set; }

        public string Title { get; set; } = "";

        public string Author { get; set; } = "";

        public string Category { get; set; } = "";

        public string CoverColor { get; set; } = "primary";

        public BookStatus Status { get; set; }

        public int AvailableCopies { get; set; }

        public DateTime? DueDate { get; set; }
    }


    // =====================================================
    // BOOK STATUS
    // =====================================================

    public enum BookStatus
    {
        Available,
        OnLoan,
        Reserved
    }


    // =====================================================
    // DUMMY BOOK DATA
    // =====================================================

    private List<Book> Books = new()
    {
        new Book
        {
            Id = 1,
            Title = "Clean Code",
            Author = "Robert C. Martin",
            Category = "Computer Science",
            CoverColor = "primary",
            Status = BookStatus.Available,
            AvailableCopies = 3
        },

        new Book
        {
            Id = 2,
            Title = "The Pragmatic Programmer",
            Author = "Andrew Hunt, David Thomas",
            Category = "Technology",
            CoverColor = "dark",
            Status = BookStatus.Available,
            AvailableCopies = 5
        },

        new Book
        {
            Id = 3,
            Title = "The Web Application Hacker's Handbook",
            Author = "Dafydd Stuttard",
            Category = "Cybersecurity",
            CoverColor = "info",
            Status = BookStatus.OnLoan,
            DueDate = new DateTime(2026, 10, 5)
        },

        new Book
        {
            Id = 4,
            Title = "Atomic Habits",
            Author = "James Clear",
            Category = "Self Help",
            CoverColor = "warning",
            Status = BookStatus.Available,
            AvailableCopies = 4
        },

        new Book
        {
            Id = 5,
            Title = "Deep Work",
            Author = "Cal Newport",
            Category = "Business",
            CoverColor = "dark",
            Status = BookStatus.Available,
            AvailableCopies = 6
        },

        new Book
        {
            Id = 6,
            Title = "The Lean Startup",
            Author = "Eric Ries",
            Category = "Business",
            CoverColor = "primary",
            Status = BookStatus.OnLoan,
            DueDate = new DateTime(2026, 9, 28)
        },

        new Book
        {
            Id = 7,
            Title = "Designing Data-Intensive Applications",
            Author = "Martin Kleppmann",
            Category = "Computer Science",
            CoverColor = "danger",
            Status = BookStatus.Available,
            AvailableCopies = 2
        },

        new Book
        {
            Id = 8,
            Title = "Introduction to Algorithms",
            Author = "Thomas H. Cormen",
            Category = "Computer Science",
            CoverColor = "secondary",
            Status = BookStatus.Available,
            AvailableCopies = 4
        },

        new Book
        {
            Id = 9,
            Title = "System Design Interview",
            Author = "Alex Xu",
            Category = "Technology",
            CoverColor = "info",
            Status = BookStatus.Available,
            AvailableCopies = 3
        },

        new Book
        {
            Id = 10,
            Title = "Think Like a Hacker",
            Author = "Peter Kim",
            Category = "Cybersecurity",
            CoverColor = "dark",
            Status = BookStatus.OnLoan,
            DueDate = new DateTime(2026, 10, 12)
        },

        new Book
        {
            Id = 11,
            Title = "The 7 Habits of Highly Effective People",
            Author = "Stephen R. Covey",
            Category = "Self Help",
            CoverColor = "primary",
            Status = BookStatus.Available,
            AvailableCopies = 5
        },

        new Book
        {
            Id = 12,
            Title = "Sapiens",
            Author = "Yuval Noah Harari",
            Category = "History",
            CoverColor = "danger",
            Status = BookStatus.Available,
            AvailableCopies = 2
        }
    };


    // =====================================================
    // CATEGORIES
    // =====================================================

    private List<string> Categories = new()
    {
        "Technology",
        "Computer Science",
        "Cybersecurity",
        "Business",
        "Fiction",
        "Science",
        "Engineering",
        "Self Help",
        "History",
        "Biography"
    };


    // =====================================================
    // FILTER STATE
    // =====================================================

    private string searchTerm = "";

    private string selectedCategory = "All";

    private bool availableOnly = false;

    private bool onLoanOnly = false;

    private bool reservedOnly = false;

    private string sortOption = "title";


    // =====================================================
    // FILTERED BOOKS
    // =====================================================

    private IEnumerable<Book> FilteredBooks
    {
        get
        {
            IEnumerable<Book> result = Books;


            // Search

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                result = result.Where(book =>
                    book.Title.Contains(
                        searchTerm,
                        StringComparison.OrdinalIgnoreCase
                    )
                    ||
                    book.Author.Contains(
                        searchTerm,
                        StringComparison.OrdinalIgnoreCase
                    )
                    ||
                    book.Category.Contains(
                        searchTerm,
                        StringComparison.OrdinalIgnoreCase
                    )
                );
            }


            // Category

            if (selectedCategory != "All")
            {
                result = result.Where(book =>
                    book.Category == selectedCategory
                );
            }


            // Availability

            if (availableOnly)
            {
                result = result.Where(book =>
                    book.Status == BookStatus.Available
                );
            }


            if (onLoanOnly)
            {
                result = result.Where(book =>
                    book.Status == BookStatus.OnLoan
                );
            }


            if (reservedOnly)
            {
                result = result.Where(book =>
                    book.Status == BookStatus.Reserved
                );
            }


            // Sorting

            result = sortOption switch
            {
                "author" =>
                    result.OrderBy(book => book.Author),

                "available" =>
                    result.OrderBy(book =>
                        book.Status != BookStatus.Available),

                _ =>
                    result.OrderBy(book => book.Title)
            };


            return result;
        }
    }


    // =====================================================
    // CATEGORY SELECTION
    // =====================================================

    private void SelectCategory(string category)
    {
        selectedCategory = category;
    }


    // =====================================================
    // BORROW BOOK
    // =====================================================

    private void BorrowBook(Book book)
    {
        if (book.AvailableCopies <= 0)
            return;

        book.AvailableCopies--;

        if (book.AvailableCopies == 0)
        {
            book.Status = BookStatus.OnLoan;

            book.DueDate = DateTime.Today.AddDays(14);
        }

        // Later this will call your API/service:
        //
        // await LibraryService.BorrowBook(book.Id);
    }


    // =====================================================
    // RESERVE BOOK
    // =====================================================

    private void ReserveBook(Book book)
    {
        book.Status = BookStatus.Reserved;

        // Later:
        //
        // await LibraryService.ReserveBook(book.Id);
    }

}