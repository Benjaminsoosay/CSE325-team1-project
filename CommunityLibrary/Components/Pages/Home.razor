@page "/"

<PageTitle>Community Library - Home</PageTitle>

<!-- Hero Section -->
<div class="hero-section text-white text-center py-5 mb-5">
    <div class="container">
        <h1 class="display-4 fw-bold mb-4">Welcome to Community Library</h1>
        <p class="lead mb-4">Your gateway to knowledge, imagination, and community connection.</p>
        <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
            <a href="/catalog" class="btn btn-primary btn-lg px-4 gap-3">Browse Catalog</a>
        </div>
    </div>
</div>

<!-- Features Section -->
<div class="container my-5">
    <div class="row text-center">
        <!-- Kept "Vast Collection" and centered it -->
        <div class="col-md-6 mx-auto mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="feature-icon bg-primary bg-gradient text-white rounded-circle mb-3 mx-auto d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="bi bi-book fs-3">📚</i>
                    </div>
                    <h4 class="card-title fw-bold">Vast Collection</h4>
                    <p class="card-text text-muted">Explore thousands of books, from classic literature to modern bestsellers.</p>
                    <a href="/catalog" class="btn btn-outline-primary mt-3">View Books</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Call to Action Section -->
<div class="bg-light py-5">
    <div class="container text-center">
        <h2 class="fw-bold mb-3">Ready to start reading?</h2>
        <p class="lead text-muted mb-4">Create an account today and get instant access to our entire catalog.</p>
        <a href="/dashboard" class="btn btn-primary btn-lg px-5">Get Started</a>
    </div>
</div>